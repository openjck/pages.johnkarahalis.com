<span class="spoiler hidden" title="Show spoiler">
  <slot />
</span>

<script>
const spoilers = document.querySelectorAll(".spoiler");
spoilers.forEach((spoiler) => {
  spoiler.addEventListener("click", (e) => {
    // This is very important for supporting nested spoilers.
    e.stopPropagation();

    // If the spoiler that was clicked is a nested spoiler (a spoiler within
    // another spoiler), apply the effect to the outermost spoiler first.
    //
    // If this were not done, the inner spoiler would toggle (e.g., hidden to
    // visible) but nothing might visibly change (e.g., if the outer spoiler
    // is still hidden).
    let target = spoiler;
    for (
      let el = spoiler.parentElement?.closest(".spoiler");
      el;
      el = el.parentElement?.closest(".spoiler")
    ) {
      if (el.classList.contains("hidden")) {
        target = el;
      }
    }

    const hidden = target.classList.toggle("hidden");
    spoiler.title = hidden ? "Show spoiler" : "Hide spoiler";
  });
});
</script>

<style>
.spoiler {
  cursor: pointer;
  transition: all 0.5s;
  border-radius: 5px;
}

.spoiler.hidden {
  background-color: var(--sl-color-text);
  color: var(--sl-color-text);
}

.spoiler.hidden::selection {
  color: var(--sl-color-text);
}
</style>
